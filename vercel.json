{
  "installCommand": "cd client && npm install",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/enquiry.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/enquiry",
      "destination": "/api/enquiry"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
